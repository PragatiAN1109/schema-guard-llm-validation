# SchemaGuard — Environment Configuration
# Copy to .env and fill in values as needed.

# --- LLM Provider (for future synthetic data generation) ---
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# --- Confidence Scoring Thresholds ---
# Records with confidence >= this are routed to "trusted"
CONFIDENCE_TRUSTED_THRESHOLD=0.85

# Records with confidence < this are routed to "quarantined"
CONFIDENCE_QUARANTINE_THRESHOLD=0.50

# --- Drift Detection ---
# Numeric field z-score shift threshold
DRIFT_NUMERIC_THRESHOLD=1.5

# Categorical PSI threshold
DRIFT_CATEGORICAL_THRESHOLD=0.20

# Null-rate change threshold
DRIFT_NULL_RATE_THRESHOLD=0.15

# Violation frequency change threshold
DRIFT_VIOLATION_RATE_THRESHOLD=0.10

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
